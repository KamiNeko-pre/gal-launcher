{
  "name": "gal-launcher",
  "version": "0.4.0",
  "private": true,
  "description": "A local Galgame launcher for Windows.",
  "main": "electron/main.cjs",
  "author": "Gal Launcher",
  "license": "MIT",
  "homepage": "https://github.com/KamiNeko-pre/gal-launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamiNeko-pre/gal-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/KamiNeko-pre/gal-launcher/issues"
  },
  "keywords": [
    "galgame",
    "visual-novel",
    "launcher",
    "electron",
    "react",
    "windows",
    "game-library",
    "vndb",
    "bangumi"
  ],
  "scripts": {
    "test": "node --test electron/network/*.test.cjs electron/metadata/*.test.cjs electron/integrations/*.test.cjs electron/library/*.test.cjs electron/library/*.test.mjs electron/packaging/*.test.cjs electron/play-session/*.test.cjs electron/window/*.test.cjs electron/search/*.test.cjs src/useLibrary.request-state.test.mjs src/scroll/*.test.mjs tools/library-navigation-contract.test.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc && vite build",
    "check": "npm test && npm run build",
    "perf:startup": "node scripts/perf/measure-startup.mjs",
    "dist": "npm run build && electron-builder --win dir",
    "dist:portable": "npm run build && electron-builder --win portable",
    "start": "cross-env NODE_ENV=production electron .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "build": {
    "appId": "local.gal-launcher.app",
    "productName": "Gal Launcher",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "38.8.6",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "!electron/**/*.test.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/integrations/invoke-magpie.ps1",
        "to": "invoke-magpie.ps1"
      },
      {
        "from": "electron/integrations/prepare-locale-runtime.ps1",
        "to": "prepare-locale-runtime.ps1"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "icon": "build/icon.ico",
    "afterPack": "electron/packaging/embed-icon.cjs",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Gal Launcher.exe"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resedit": "^1.7.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  }
}
